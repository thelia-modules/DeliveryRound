{% set domain = 'deliveryround' %}
{% set config_url = '/admin/module/DeliveryRound' %}

{% macro sort_header(label, key, current_order, config_url) %}
    {% set is_asc = current_order == key %}
    {% set is_desc = current_order == key ~ '-reverse' %}
    <a href="{{ config_url }}?order={{ is_asc ? key ~ '-reverse' : key }}" class="text-decoration-none">
        {{ label }}
        {% if is_asc %}<i class="bi bi-caret-up-fill" aria-hidden="true"></i>{% elseif is_desc %}<i class="bi bi-caret-down-fill" aria-hidden="true"></i>{% endif %}
    </a>
{% endmacro %}

<div class="card mb-4">
    <div class="card-header">{{ 'configure delivery round price'|trans({}, domain) }}</div>
    <div class="card-body">
        {{ form_start(config_form, {action: path('deliveryround_config'), method: 'post', attr: {class: 'row g-2 align-items-end'}}) }}
            <div class="col-auto">
                {{ form_label(config_form.price, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(config_form.price, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, domain) }}</button>
            </div>
        {{ form_end(config_form) }}
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">{{ 'configure delivery rounds'|trans({}, domain) }}</div>
    <div class="card-body">
        {{ form_start(add_form, {action: path('deliveryround_addlocation'), method: 'post', attr: {class: 'row g-2 align-items-end mb-4'}}) }}
            <div class="col-md-2">
                {{ form_label(add_form.zipcode, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(add_form.zipcode, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="col-md-2">
                {{ form_label(add_form.city, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(add_form.city, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="col-md-3">
                {{ form_label(add_form.address, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(add_form.address, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="col-md-2">
                {{ form_label(add_form.day, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(add_form.day, {attr: {class: 'form-select'}}) }}
            </div>
            <div class="col-md-2">
                {{ form_label(add_form.delivery_period, null, {label_attr: {class: 'form-label'}}) }}
                {{ form_widget(add_form.delivery_period, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">{{ 'Add'|trans({}, domain) }}</button>
            </div>
        {{ form_end(add_form) }}

        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle" id="delivery-round-table">
                <thead>
                    <tr>
                        <th>{{ _self.sort_header('ZipCode'|trans({}, domain), 'zipcode', order, config_url) }}</th>
                        <th>{{ _self.sort_header('City'|trans({}, domain), 'city', order, config_url) }}</th>
                        <th>{{ 'Address'|trans({}, domain) }}</th>
                        <th>{{ _self.sort_header('Day'|trans({}, domain), 'day', order, config_url) }}</th>
                        <th>{{ 'Delivery period'|trans({}, domain) }}</th>
                        <th class="text-end">{{ 'Actions'|trans({}, domain) }}</th>
                    </tr>
                </thead>
                <tbody>
                {% for round in rounds %}
                    {% set f = round.update_form %}
                    {% set form_id = 'deliveryround-update-' ~ round.id %}
                    <tr>
                        <td>{{ form_widget(f.zipcode, {id: form_id ~ '-zipcode', attr: {class: 'form-control form-control-sm', form: form_id}}) }}</td>
                        <td>{{ form_widget(f.city, {id: form_id ~ '-city', attr: {class: 'form-control form-control-sm', form: form_id}}) }}</td>
                        <td>{{ form_widget(f.address, {id: form_id ~ '-address', attr: {class: 'form-control form-control-sm', form: form_id}}) }}</td>
                        <td>{{ form_widget(f.day, {id: form_id ~ '-day', attr: {class: 'form-select form-select-sm', form: form_id}}) }}</td>
                        <td>{{ form_widget(f.delivery_period, {id: form_id ~ '-delivery_period', attr: {class: 'form-control form-control-sm', form: form_id}}) }}</td>
                        <td class="text-end text-nowrap">
                            {{ form_start(f, {action: path('deliveryround_update'), method: 'post', attr: {id: form_id, class: 'd-inline'}}) }}
                                {{ form_widget(f.id, {type: 'hidden', id: form_id ~ '-id'}) }}
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="{{ 'Save'|trans({}, domain) }}"><i class="bi bi-check-lg" aria-hidden="true"></i></button>
                            {{ form_end(f) }}

                            {% set d = round.delete_form %}
                            {{ form_start(d, {action: path('deliveryround_delete'), method: 'post', attr: {class: 'd-inline'}}) }}
                                {{ form_widget(d.id, {type: 'hidden', id: 'deliveryround-delete-' ~ round.id}) }}
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="{{ 'Remove'|trans({}, domain) }}"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            {{ form_end(d) }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-3">{{ 'No delivery round yet.'|trans({}, domain) }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
